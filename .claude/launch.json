{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "economy-saver",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "economy-saver",
        "run",
        "dev",
        "--",
        "-p",
        "3123"
      ],
      "port": 3123
    },
    {
      "name": "codex-bridge",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "economy-saver",
        "run",
        "codex:bridge"
      ],
      "port": 3130
    },
    {
      "name": "worker-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "economy-saver",
        "run",
        "cf:preview"
      ],
      "port": 8787
    },
    {
      "name": "design-mockup",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "require('http').createServer((q,s)=>{s.setHeader('content-type','text/html; charset=utf-8');s.end('<!doctype html><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\">'+require('fs').readFileSync('design/one-screen.html','utf8'))}).listen(+process.env.PORT||3125,'127.0.0.1')"
      ],
      "port": 3125
    }
  ]
}