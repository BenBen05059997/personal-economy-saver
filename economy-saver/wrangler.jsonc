{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-economy-saver",
  "main": "worker.ts",
  "minify": true,
  // Also protect direct Wrangler dev/build commands against OpenNext’s dotenv export.
  "build": { "command": "node scripts/worker-runtime-env.mjs" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "personal-economy-saver" }
  ],
  "observability": { "enabled": true },
  "triggers": {
    // Check each household’s local reminder hour.
    "crons": ["0 * * * *"]
  }
}
