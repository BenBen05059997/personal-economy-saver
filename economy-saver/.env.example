# Copy this file to .env.local and fill it in. Never commit .env.local.

# Must stay SANDBOX. The app refuses to run with any other value.
PAYPAL_ENVIRONMENT=SANDBOX

# developer.paypal.com -> Apps & Credentials -> Sandbox. Use an app linked to the Japan sandbox account (the freelancer).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Owner copies this privately from the PayPal sandbox dashboard after registration.
PAYPAL_WEBHOOK_ID=

# Email of the US sandbox personal account that receives the demo invoices.
SANDBOX_CLIENT_EMAIL=

# The default AI connection (D33, D56): used when a household has not set its own.
# AI_PROTOCOL is anthropic (the address is fixed) or openai (OpenAI-compatible Chat Completions; AI_BASE_URL is required).
AI_PROTOCOL=
AI_BASE_URL=
AI_API_KEY=

# Supabase (supabase.com -> your project -> Project Settings -> API, and -> Database -> Connection string).
# The URL and anon key are safe in the browser; the service role key and DATABASE_URL never leave the server.
SUPABASE_URL=
# The app's own address; sign-in links return here. Local: http://127.0.0.1:3123. Add it to Supabase Auth redirect URLs.
APP_URL=
# The request header that holds the client address, for the per-address limit on the sign-in link. Required.
# cf-connecting-ip on the Cloudflare Worker; x-forwarded-for under `next dev` (Next sets it from the socket).
CLIENT_IP_HEADER=x-forwarded-for
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the "Transaction pooler" string (port 6543): Workers open short-lived connections.
DATABASE_URL=

# Bearer token the Cron Trigger sends to /api/cron. Generate with: openssl rand -base64 32
CRON_SECRET=

# A dedicated 32-byte key (base64url) for sealing MCP token routing data. Server only.
MCP_TOKEN_KEY=

# A dedicated 32-byte key (unpadded base64url) that seals a household's own AI key before it goes into Vault. Server only.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_KEY_SEAL_KEY=

# Model IDs as your provider names them (no defaults are built in).
# AI_DOCUMENT_MODEL reads uploads and PDFs (it must accept images); AI_TEXT_MODEL reads forwarded emails and also answers Ask.
AI_DOCUMENT_MODEL=
AI_TEXT_MODEL=
# Optional Ask timeout in milliseconds for slow development models. Production leaves it unset (20000).
ASK_BUDGET_MS=
SUPABASE_DOCUMENT_BUCKET=
# Owner's Email Routing domain, a 64-hex-character AES key, and a separate Worker-to-app secret.
FORWARDING_DOMAIN=
INBOUND_ADDRESS_KEY=
INBOUND_WORKER_SECRET=
# Only this non-demo household may read the merchant-wide sandbox balance.
PAYPAL_BALANCE_HOUSEHOLD_ID=

# Optional email reminders. The From address must belong to the Resend sender domain.
RESEND_API_KEY=
REMINDER_FROM=
# Optional web push. npm run push:keys writes the two VAPID keys. The subject is a mailto or HTTPS contact URL.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
