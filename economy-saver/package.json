{
  "name": "economy-saver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke": "tsx scripts/smoke-test.ts",
    "webhook:register": "tsx scripts/register-webhook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig ./tsconfig.json scripts/seed.ts",
    "db:vault-check": "tsx --tsconfig ./tsconfig.json scripts/vault-check.ts",
    "db:test": "tsx --tsconfig ./tsconfig.json scripts/db-test.ts && npm run db:approve-test && npm run mcp:demo && npm run db:reader-test && npm run db:settings-test && npm run db:refresh-test",
    "db:approve-test": "tsx --tsconfig ./tsconfig.json scripts/approve-test.ts",
    "cf:build": "node scripts/build-worker.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview --port 8787",
    "cf:size": "npm run cf:build && wrangler deploy --dry-run --outdir .wrangler/dryout && node scripts/check-worker-secrets.mjs",
    "cf:deploy": "npm run cf:size && opennextjs-cloudflare deploy",
    "mcp:demo": "tsx --tsconfig ./tsconfig.json scripts/mcp-test.ts",
    "db:reader-test": "tsx --tsconfig ./tsconfig.json scripts/reader-test.ts",
    "db:settings-test": "tsx --tsconfig ./tsconfig.json scripts/settings-test.ts",
    "db:refresh-test": "tsx --tsconfig ./tsconfig.json scripts/paypal-refresh-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postal-mime": "4.2.0",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@opennextjs/cloudflare": "1.20.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  }
}
