# Local `opennextjs-cloudflare preview` / `wrangler dev` read economy-saver/.dev.vars.
# Create it with: cp .env.local .dev.vars   (never commit .dev.vars)
# In production set each of these with `wrangler secret put NAME`.
PAYPAL_ENVIRONMENT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SANDBOX_CLIENT_EMAIL=
AI_PROTOCOL=
AI_BASE_URL=
AI_API_KEY=
SUPABASE_URL=
APP_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Bearer token the Cron Trigger sends to /api/cron. Generate with: openssl rand -base64 32
CRON_SECRET=

# Comma-separated household UUIDs included in the daily reminder job.
CRON_HOUSEHOLD_IDS=

# Same dedicated 32-byte base64url key as local config.
MCP_TOKEN_KEY=

# A dedicated 32-byte key (unpadded base64url) that seals a household's own AI key before it goes into Vault. Server only.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_KEY_SEAL_KEY=
AI_DOCUMENT_MODEL=
AI_TEXT_MODEL=
SUPABASE_DOCUMENT_BUCKET=
FORWARDING_DOMAIN=
INBOUND_ADDRESS_KEY=
INBOUND_WORKER_SECRET=
PAYPAL_BALANCE_HOUSEHOLD_ID=
CLIENT_IP_HEADER=cf-connecting-ip
