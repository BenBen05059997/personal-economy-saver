# Local `opennextjs-cloudflare preview` / `wrangler dev` read economy-saver/.dev.vars.
# Create it with: cp .env.local .dev.vars   (never commit .dev.vars)
# In production set each of these with `wrangler secret put NAME`.
PAYPAL_ENVIRONMENT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# fipa's partner attribution code, sent on every PayPal call (D13).
PAYPAL_PARTNER_ATTRIBUTION_ID=
# fipa's own platform merchant id: used in partner paths and as the payee for Try it.
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
AI_PROTOCOL=
AI_BASE_URL=
AI_API_KEY=
SUPABASE_URL=
APP_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Bearer token the Cron Trigger sends to /api/cron. Generate with: openssl rand -base64 32
CRON_SECRET=

# Same dedicated 32-byte base64url key as local config.
MCP_TOKEN_KEY=

# A dedicated 32-byte key (unpadded base64url) that seals a household's own AI key before it goes into Vault. Server only.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_KEY_SEAL_KEY=
AI_DOCUMENT_MODEL=
AI_TEXT_MODEL=
# Optional Ask timeout in milliseconds for slow development models. Production leaves it unset (20000).
ASK_BUDGET_MS=
SUPABASE_DOCUMENT_BUCKET=
FORWARDING_DOMAIN=
INBOUND_ADDRESS_KEY=
INBOUND_WORKER_SECRET=
CLIENT_IP_HEADER=cf-connecting-ip

# Optional email reminders. The From address must belong to the Resend sender domain.
RESEND_API_KEY=
REMINDER_FROM=
# Optional web push. npm run push:keys writes the two VAPID keys. The subject is a mailto or HTTPS contact URL.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
