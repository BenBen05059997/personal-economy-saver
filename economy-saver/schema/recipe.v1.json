                  "view",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "view"
                  },
                  "view": {
                    "type": "string",
                    "const": "savings_rate"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "months": {
                        "$ref": "#/properties/blocks/items/anyOf/13/anyOf/4/properties/args/properties/months"
                      }
                    },
