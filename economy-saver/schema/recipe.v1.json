                    "const": "month_pace"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "month": {
                        "$ref": "#/properties/blocks/items/anyOf/13/anyOf/3/properties/args/properties/month"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "view",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "view"
                  },
                  "view": {
                    "type": "string",
                    "const": "fixed_costs"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "months": {
                        "$ref": "#/properties/blocks/items/anyOf/13/anyOf/4/properties/args/properties/months"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "view",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "view"
                  },
                  "view": {
                    "type": "string",
                    "const": "search_months"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "months": {
                        "$ref": "#/properties/blocks/items/anyOf/13/anyOf/4/properties/args/properties/months"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "view",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "view"
                  },
                  "view": {
                    "type": "string",
                    "const": "money_flow"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "month": {
